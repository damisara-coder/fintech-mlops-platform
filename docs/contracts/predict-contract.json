{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FastAPI Predict Contract (P3 -> P1)",
  "description": "Contrat formel gelé en S1 pour l'appel de risk-service vers FastAPI POST /predict",
  "version": "1.0.0",
  "endpoint": {
    "method": "POST",
    "path": "/predict",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "request": {
    "type": "object",
    "required": [
      "tx_id",
      "amount",
      "currency",
      "channel",
      "ip_country",
      "ip_risk",
      "merchant_cat",
      "hour",
      "account_age_days"
    ],
    "properties": {
      "tx_id": {
        "type": "string",
        "example": "TX-9F219"
      },
      "amount": {
        "type": "number",
        "minimum": 0.01,
        "example": 550.0
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "example": "EUR"
      },
      "channel": {
        "type": "string",
        "enum": ["card", "wire", "sepa", "transfer"],
        "example": "card"
      },
      "ip_country": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2,
        "example": "ES"
      },
      "ip_risk": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "example": 0.61
      },
      "merchant_cat": {
        "type": "string",
        "example": "electronics_new"
      },
      "hour": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23,
        "example": 3
      },
      "account_age_days": {
        "type": "integer",
        "minimum": 0,
        "example": 2190
      }
    }
  },
  "response": {
    "status_code": 200,
    "type": "object",
    "required": [
      "prediction",
      "probability",
      "uncertainty_score",
      "is_uncertain",
      "interval",
      "model_version",
      "latency_ms"
    ],
    "properties": {
      "prediction": {
        "type": "integer",
        "enum": [0, 1],
        "description": "0 = Légitime, 1 = Fraude",
        "example": 1
      },
      "probability": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Probabilité prédite de fraude",
        "example": 0.52
      },
      "uncertainty_score": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Score d'incertitude issu de MAPIE (Conformal Prediction)",
        "example": 0.34
      },
      "is_uncertain": {
        "type": "boolean",
        "description": "true si l'incertitude dépasse le seuil alpha (ex: 0.05)",
        "example": true
      },
      "interval": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2,
        "description": "Intervalle de prédiction conforme [borne_inf, borne_sup]",
        "example": [0.48, 0.56]
      },
      "model_version": {
        "type": "string",
        "description": "Version du modèle actif dans MLflow",
        "example": "v4.2"
      },
      "latency_ms": {
        "type": "integer",
        "description": "Temps de calcul de l'inférence en millisecondes",
        "example": 38
      }
    }
  }
}
