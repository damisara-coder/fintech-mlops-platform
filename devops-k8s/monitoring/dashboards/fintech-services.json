{
  "title": "FinTech - Services",
  "uid": "fintech-services",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Services up (sur 6)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(up{job=\"fintech-services\"})" } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 4 }, { "color": "green", "value": 6 } ] } }, "overrides": [] } },
    { "id": 2, "type": "timeseries", "title": "Requetes par seconde",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [ { "refId": "A", "legendFormat": "{{app}}", "expr": "sum by (app) (rate(http_server_requests_seconds_count[1m]))" } ] },
    { "id": 3, "type": "timeseries", "title": "Latence moyenne (secondes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "targets": [ { "refId": "A", "legendFormat": "{{app}}", "expr": "sum by (app) (rate(http_server_requests_seconds_sum[1m])) / sum by (app) (rate(http_server_requests_seconds_count[1m]))" } ] },
    { "id": 4, "type": "timeseries", "title": "Memoire heap Java (Mo)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [ { "refId": "A", "legendFormat": "{{app}}", "expr": "sum by (app) (jvm_memory_used_bytes{area=\"heap\"}) / 1024 / 1024" } ] },
    { "id": 5, "type": "timeseries", "title": "CPU utilise (0 a 1)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [ { "refId": "A", "legendFormat": "{{app}}", "expr": "process_cpu_usage" } ] },
    { "id": 6, "type": "timeseries", "title": "Erreurs 5xx par seconde",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [ { "refId": "A", "legendFormat": "{{app}}", "expr": "sum by (app) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))" } ] }
  ]
}
