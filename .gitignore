.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# -----------------
# Java & Maven
# -----------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# -----------------
# Python & MLOps
# -----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.tox/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# MLflow & Large Datasets
mlruns/
mlartifacts/
mlflow-data/
*.db
requirements-lock.txt
*.joblib
*.pkl
*.h5
*.onnx
# Ignore heavy raw dataset CSVs (keep sample / compressed if needed)
ml-research/datasets/*.csv
!ml-research/datasets/sample_*.csv
ml-research/datasets/*.zip
ml-research/datasets/*.tar.gz

# -----------------
# Node & Frontend (React/Vite)
# -----------------
node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------
# Secrets & Environment Variables
# -----------------
*.env
*.env.local
*.env.*.local
!*.env.example
secrets/
*.pem
*.key
*.p12
*.crt

# -----------------
# Logs
